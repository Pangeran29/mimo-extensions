{
  "name": "meeting-audio-recorder",
  "version": "0.13.1",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "node scripts/build.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:latency-tools": "node scripts/test-notes-latency-tools.mjs",
    "test:whisper-debug": "node scripts/test-whisper-debug.mjs",
    "check": "pnpm typecheck && pnpm test && pnpm test:relay && pnpm test:latency-tools && pnpm test:whisper-debug && pnpm test:live-memo-tools && pnpm build",
    "relay": "node server/relay.mjs",
    "test:relay": "node --test server/relay.check.mjs server/notes.check.mjs",
    "test:live-memo-tools": "node --test scripts/live-memo-budget.check.mjs scripts/live-memo-report.check.mjs scripts/live-memo-v2-report.check.mjs scripts/live-memo-review-server.check.mjs",
    "review:v2": "node scripts/live-memo-review-server.mjs",
    "replay:lab": "node scripts/replay-lab.mjs",
    "test:replay-lab": "node scripts/replay-lab-smoke.mjs",
    "test:end-meeting": "node scripts/end-meeting-smoke.mjs",
    "test:end-meeting:ui": "node scripts/end-meeting-ui-smoke.mjs"
  },
  "devDependencies": {
    "@types/chrome": "^0.0.287",
    "esbuild": "^0.25.0",
    "fake-indexeddb": "^6.0.0",
    "playwright": "^1.64.1",
    "prettier": "3.6.2",
    "typescript": "^5.7.0",
    "vitest": "^3.2.0"
  },
  "packageManager": "pnpm@11.25.0",
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@ricky0123/vad-web": "0.0.30",
    "openai": "7.33.0",
    "zod": "4.6.7"
  }
}
